# ── API Keys ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...          # 用于 Whisper 转录
ANTHROPIC_API_KEY=sk-ant-...   # 用于 Claude 信息提取

# ── 路径配置 ──────────────────────────────────────────────────────────────────
# 监听目录（把录音文件丢进来触发处理）
# macOS iCloud 路径（推荐，iPhone 录音自动同步）：
WATCH_DIR=/Users/你的用户名/Library/Mobile Documents/com~apple~CloudDocs/OzskyVoice
# 或 Dropbox：
# WATCH_DIR=/Users/你的用户名/Dropbox/OzskyVoice

# Obsidian Vault 位置
VAULT_DIR=/Users/你的用户名/Liang-Brain

# Meetings 笔记保存位置（默认 VAULT_DIR/03-Meetings）
# MEETINGS_DIR=/Users/你的用户名/Liang-Brain/03-Meetings

# ── NexusCRM 配置 ─────────────────────────────────────────────────────────────
# 生产环境（Netlify 部署后的 URL）：
CRM_BASE_URL=https://your-nexus-crm.netlify.app
# 本地开发（运行 `netlify dev` 时）：
# CRM_BASE_URL=http://localhost:8888
CRM_API_KEY=                   # 如果你给 API 加了密钥验证

# ── 可选：日志级别 ────────────────────────────────────────────────────────────
# LOG_LEVEL=debug
