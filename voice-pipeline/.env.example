# ── API Keys ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...          # 用于 Whisper 转录 (OpenAI)
ANTHROPIC_API_KEY=sk-ant-...   # 用于 Claude 信息提取 (Anthropic)

# ── Obsidian Vault 路径 ───────────────────────────────────────────────────────
# 你的 Obsidian Vault 根目录
VAULT_DIR=/Users/liang/Documents/J-Brain

# 监听目录：Obsidian 录音默认存在 Vault/Attachments/
# Obsidian Sync 会自动把手机录音同步到这里
WATCH_DIR=/Users/liang/Documents/J-Brain/Attachments

# 会议笔记写入位置（默认 VAULT_DIR/03-Meetings，可自定义）
# MEETINGS_DIR=/Users/liang/Documents/J-Brain/03-Meetings

# ── NexusCRM 配置 ─────────────────────────────────────────────────────────────
# 生产环境（你的 Netlify 部署 URL）：
CRM_BASE_URL=https://your-nexus-crm.netlify.app
# 本地开发（运行 `netlify dev` 时）：
# CRM_BASE_URL=http://localhost:8888

# 可选：API Key 验证（在 Netlify 环境变量里也要设置同样的值）
CRM_API_KEY=

# ── 可选 ─────────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug
