<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 守护进程配置 — Ozsky Voice Pipeline
  ─────────────────────────────────────────────────────────────
  安装（在 nexus-crm/voice-pipeline/ 目录里运行）：
    cp com.ozsky.voice-pipeline.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.ozsky.voice-pipeline.plist

  查看日志：
    tail -f /tmp/ozsky-voice-pipeline.log

  停止/重启：
    launchctl unload ~/Library/LaunchAgents/com.ozsky.voice-pipeline.plist
    launchctl load   ~/Library/LaunchAgents/com.ozsky.voice-pipeline.plist
  ─────────────────────────────────────────────────────────────
  ⚠ 安装前先把下面两个路径改成你的实际路径：
    /Users/liang/...  →  你的实际用户名
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ozsky.voice-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/liang/Documents/nexus-crm/voice-pipeline/watch.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/liang/Documents/nexus-crm/voice-pipeline</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <!-- 如果你不用 .env 文件，可以在这里直接写 API Keys -->
    <!-- <key>OPENAI_API_KEY</key>    <string>sk-...</string> -->
    <!-- <key>ANTHROPIC_API_KEY</key> <string>sk-ant-...</string> -->
    <!-- <key>CRM_BASE_URL</key>      <string>https://your-nexus-crm.netlify.app</string> -->
  </dict>

  <!-- 崩溃后自动重启 -->
  <key>KeepAlive</key>
  <true/>

  <!-- 登录后自动启动 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 日志 -->
  <key>StandardOutPath</key>
  <string>/tmp/ozsky-voice-pipeline.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ozsky-voice-pipeline-error.log</string>
</dict>
</plist>
